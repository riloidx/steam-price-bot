{
  "name": "steam-price-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot: Steam game prices in a foreign region converted to your currency with top-up fee",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRiloid/node-js-test-tg-bot.git"
  },
  "license": "ISC",
  "dependencies": {
    "grammy": "^1.36.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.0"
  }
}
